{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:kalshi-live-data": "esbuild src/lib/kalshi-live-data-probe.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/kalshi-live-data-probe.mjs && node .local/kalshi-live-data-probe.mjs",
    "test:roi-db": "esbuild src/lib/roi-leaderboard-db.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=../../lib/db/src/index.ts --alias:@workspace/api-zod=../../lib/api-zod/src/index.ts --outfile=../../lib/db/.local/store-tests/roi-leaderboard-db.mjs && node --test ../../lib/db/.local/store-tests/roi-leaderboard-db.mjs",
    "test:acquisition-store": "esbuild src/lib/kalshi-acquisition-store.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=../../lib/db/src/index.ts --outfile=../../lib/db/.local/store-tests/kalshi-acquisition-store.mjs && node --test ../../lib/db/.local/store-tests/kalshi-acquisition-store.mjs",
    "test:telegram": "esbuild src/lib/telegram-dashboard.test.ts src/lib/telegram-trade-notifications.test.ts src/lib/telegram-game-status.test.ts src/lib/telegram-scope-direction.test.ts src/lib/owner-policy.test.ts src/lib/kalshi-results-source.test.ts src/lib/kalshi-score-queue.test.ts src/lib/kalshi-http.test.ts src/lib/kalshi-trade-stream.test.ts src/lib/kalshi-acquisition.test.ts src/lib/kalshi-recovery.test.ts src/lib/market-flow.test.ts src/lib/history-analysis.test.ts src/lib/roi-ranking.test.ts --bundle --platform=node --format=esm --packages=external --outdir=.local/tests --out-extension:.js=.mjs && NODE_ENV=production node --test .local/tests/*test.mjs",
    "check:kalshi-websocket": "esbuild src/lib/kalshi-websocket-probe.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/kalshi-websocket-probe.mjs && node .local/kalshi-websocket-probe.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.82",
    "@clerk/shared": "^4.41.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
